# ============================================================
# MercAPP POS — Variables de Entorno de Ejemplo
# ============================================================

# Clave secreta para sesiones y firma de tokens JWT (generar una aleatoria en producción)
SECRET_KEY=cambiar-por-una-clave-secreta-segura-en-produccion

# Base de datos (opcional: si no se define, usa SQLite local mercapp.db)
# DATABASE_URL=mysql+pymysql://usuario:contraseña@servidor:3306/mercapp

# Orígenes CORS permitidos (separados por coma, o dejar vacío para rechazar credenciales en orígenes cruzados)
CORS_ORIGINS=https://mercapp-deploy.onrender.com,http://localhost:5000,http://127.0.0.1:5000

# Clave maestra para activación de licencia
LICENSE_MASTER_KEY=clave-maestra-desbloqueo-2026

# Configuración de correo SMTP para verificaciones y reportes
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion
MAIL_DEFAULT_SENDER=tu_correo@gmail.com

# Modo de ejecución (production / development)
FLASK_ENV=development
